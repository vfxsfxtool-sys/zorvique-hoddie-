{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n store,admin -c amber,cyan \"npx vite apps/storefront --port 3000 --host 0.0.0.0\" \"npx vite apps/admin --port 3001 --host 0.0.0.0\"",
    "build": "npx vite build apps/admin && npx vite build apps/storefront",
    "start": "npx vite preview apps/storefront --port 3000 --host 0.0.0.0",
    "lint": "eslint apps/storefront/src apps/admin/src firestore.rules",
    "clean": "rm -rf apps/storefront/dist apps/admin/dist"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.2.1",
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "firebase": "^13.4.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.11.0",
    "tailwind-merge": "^3.3.1",
    "three": "^0.187.0",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
